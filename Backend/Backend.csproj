<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <None Include="convert-lunar.js" CopyToOutputDirectory="PreserveNewest" />
    <None Include="package.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Auto install npm packages after build -->
  <Target Name="NpmInstall" AfterTargets="Build">
    <Exec Command="npm install" WorkingDirectory="$(OutputPath)" Condition="!Exists('$(OutputPath)node_modules')" />
  </Target>

</Project>
